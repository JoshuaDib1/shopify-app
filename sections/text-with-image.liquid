Text with Image
{% schema %}
{
"name": "Text with Image",
"tag": "section",
"class": "section",
"settings": [
{
"type": "text",
"id": "section_title",
"label": "Section Title",
"default": "Text with Image"
},
{
"type": "select",
"id": "layout",
"label": "Layout",
"options": [
{
"value": "image_left",
"label": "Image Left, Text Right"
},
{
"value": "text_left",
"label": "Text Left, Image Right"
}
],
"default": "image_left"
},
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#ffffff"
},
{
"type": "color",
"id": "text_color",
"label": "Text Color",
"default": "#000000"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Padding Top",
"default": 40
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Padding Bottom",
"default": 40
},
{
"type": "range",
"id": "content_gap",
"min": 20,
"max": 120,
"step": 10,
"unit": "px",
"label": "Space Between Content",
"default": 40
}
],
"blocks": [
{
"type": "image",
"name": "Image",
"limit": 1,
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Image"
},
{
"type": "range",
"id": "image_width",
"min": 200,
"max": 800,
"step": 50,
"unit": "px",
"label": "Image Width",
"default": 500
},
{
"type": "select",
"id": "image_style",
"label": "Image Style",
"options": [
{
"value": "default",
"label": "Default"
},
{
"value": "rounded",
"label": "Rounded"
},
{
"value": "circle",
"label": "Circle"
},
{
"value": "shadow",
"label": "Shadow"
}
],
"default": "default"
}
]
},
{
"type": "text_content",
"name": "Text Content",
"limit": 1,
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "Compelling Headline"
},
{
"type": "select",
"id": "heading_size",
"label": "Heading Size",
"options": [
{
"value": "h1",
"label": "H1"
},
{
"value": "h2",
"label": "H2"
},
{
"value": "h3",
"label": "H3"
}
],
"default": "h2"
},
{
"type": "text",
"id": "subheading",
"label": "Subheading",
"default": "Supporting subheading text"
},
{
"type": "richtext",
"id": "paragraph",
"label": "Paragraph",
"default": "<p>Pair large text with an image to tell a story, explain a detail about your
product, or describe a new promotion. Include information that emphasizes the value of your
offering.</p>"
},
{
"type": "select",
"id": "text_alignment",
"label": "Text Alignment",
"options": [
{
"value": "left",
"label": "Left"
},
{
"value": "center",
"label": "Center"
},
{
"value": "right",
"label": "Right"
}
],
"default": "left"
},
{
"type": "header",
"content": "Primary Button"
},
{
"type": "text",
"id": "button_label",
"label": "Button Label",
"default": "Shop Now"
},
{
"type": "url",
"id": "button_link",
"label": "Button Link"
},
{
"type": "color",
"id": "button_color",
"label": "Button Color",
"default": "#000000"
},
{
"type": "color",
"id": "button_text_color",
"label": "Button Text Color",
"default": "#ffffff"
},
{
"type": "header",
"content": "Secondary Button"
},
{
"type": "text",
"id": "secondary_button_label",
"label": "Secondary Button Label"
},
{
"type": "url",
"id": "secondary_button_link",
"label": "Secondary Button Link"
},
{
"type": "color",
"id": "secondary_button_color",
"label": "Secondary Button Color",
"default": "#ffffff"
},
{
"type": "color",
"id": "secondary_button_text_color",
"label": "Secondary Button Text Color",
"default": "#000000"
}
]
}
],
"presets": [
{
"name": "Text with Image",
"blocks": [
{
"type": "image"
},
{
"type": "text_content"
}
]
}
]
}
{% endschema %}
<section class="text-with-image-section"
style="
background-color: {{ section.settings.bg_color }};
color: {{ section.settings.text_color }};
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
">
<div class="container">
{% if section.settings.section_title != blank %}
<h2 class="section-title">{{ section.settings.section_title }}</h2>
{% endif %}
<div class="text-with-image-wrapper {% if section.settings.layout == 'text_left' %}text-left{%
else %}image-left{% endif %}" style="gap: {{ section.settings.content_gap }}px;">
{% for block in section.blocks %}
{% case block.type %}
{% when 'image' %}
<div class="image-container" {{ block.shopify_attributes }}>
{% if block.settings.image != blank %}
<img src="{{ block.settings.image | img_url: 'master' }}"
alt="{{ block.settings.image.alt | escape }}"
width="{{ block.settings.image_width }}"
class="feature-image image-style-{{ block.settings.image_style }}"
loading="lazy">
{% else %}
<div class="placeholder-image image-style-{{ block.settings.image_style }}"
style="width: {{ block.settings.image_width }}px;">
{{ 'product-1' | placeholder_svg_tag }}
</div>
{% endif %}
</div>
{% when 'text_content' %}
<div class="text-content text-{{ block.settings.text_alignment }}" {{
block.shopify_attributes }}>
{% if block.settings.heading != blank %}
<{{ block.settings.heading_size }} class="content-heading">{{ block.settings.heading
}}</{{ block.settings.heading_size }}>
{% endif %}
{% if block.settings.subheading != blank %}
<div class="content-subheading">{{ block.settings.subheading }}</div>
{% endif %}
{% if block.settings.paragraph != blank %}
<div class="content-paragraph">{{ block.settings.paragraph }}</div>
{% endif %}
<div class="button-container">
{% if block.settings.button_label != blank %}
<a href="{{ block.settings.button_link }}" class="button primary-button"
style="background-color: {{ block.settings.button_color }}; color: {{
block.settings.button_text_color }};">
{{ block.settings.button_label }}
</a>
{% endif %}
{% if block.settings.secondary_button_label != blank %}
<a href="{{ block.settings.secondary_button_link }}" class="button secondary-button"
style="background-color: {{ block.settings.secondary_button_color }}; color: {{
block.settings.secondary_button_text_color }}; border: 1px solid {{
block.settings.secondary_button_text_color }};">
{{ block.settings.secondary_button_label }}
</a>
{% endif %}
</div>
</div>
{% endcase %}
{% endfor %}
</div>
</div>
</section> 